# Copy to .env and fill in values:  cp .env.example .env

# --- Shared ---
JWT_SECRET=change-me-use-openssl-rand-hex-32
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# --- Frontend (browser-facing URLs; use your public domain in production) ---
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:5000
NEXT_PUBLIC_CHAT_SERVICE_URL=http://localhost:5082
NEXT_PUBLIC_SHARED_SECRET=change-me-shared-secret
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- MongoDB (docker-compose.yml uses internal host `mongo`) ---
MONGO_URI=mongodb://mongo:27017

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- RabbitMQ (docker-compose defaults: pulse / pulse) ---
RABBITMQ_USER=pulse
RABBITMQ_PASSWORD=pulse
Rabbitmq_Host=rabbitmq
Rabbitmq_Username=pulse
Rabbitmq_Password=pulse

# --- Cloudinary (user + chat media) ---
Cloud_Name=
Api_key=
Api_Secret=

# --- Chat service ---
PORT=5082
USER_SERVICE_URL=http://user:5000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com

# --- Mail / SMTP (do NOT use USER/PASSWORD — reserved in Docker) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- Production image registry (docker-compose.prod.yml) ---
GHCR_IMAGE_PREFIX=ghcr.io/your-github-username
IMAGE_TAG=latest
